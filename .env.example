DATABASE_URL="postgresql://app:app@localhost:5432/contact_center"

# Token n8n uses to call the CCMS API (Authorization: Bearer ...)
CCMS_SERVICE_TOKEN=""

# n8n: CCMS pushes outbox events here (optional; n8n can poll /api/events instead)
N8N_EVENT_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""

# Neutrinos Reels runtime (local decision tables are used when unset).
# Import reels/products/*.json into Reels, then put each product's workflowId below.
REELS_BASE_URL=""            # https://sandbox.neutrinos-apps.com
REELS_IDS_URL=""             # https://sandbox-ids.neutrinos-apps.com
REELS_CLIENT_ID=""
REELS_CLIENT_SECRET=""
REELS_PRODUCT_VERSION="1.0.0"
REELS_PRODUCT_CASE_CLASSIFICATION=""
REELS_PRODUCT_PRIORITY_TARGET=""
REELS_PRODUCT_ALLOCATION=""
REELS_PRODUCT_SLA_THRESHOLDS=""
REELS_PRODUCT_BU_NOTIFICATION=""
REELS_PRODUCT_APPROVAL_ROUTING=""
REELS_PRODUCT_RCA_TRIGGER=""
REELS_PRODUCT_QA_SAMPLING=""

# Neutrinos AI Hub (local stand-ins are used when unset). Each agent has its own API key.
KAMIOS_BASE_URL=""           # https://aihub-staging.neutrinos.com
KAMIOS_AUTH_HEADER=""        # header name the AI Hub keys go in (see an existing AI Hub credential in n8n)
KAMIOS_AGENT_INTAKE_EXTRACTION=""
KAMIOS_AGENT_PRELIMINARY_ASSESSMENT=""
KAMIOS_AGENT_DUPLICATE_DETECTION=""
KAMIOS_AGENT_RESPONSE_DRAFTING=""
KAMIOS_AGENT_RCA_SUGGESTION=""
KAMIOS_AGENT_CASE_SUMMARY=""
